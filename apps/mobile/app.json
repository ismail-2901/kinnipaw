{
  "expo": {
    "name": "KINNIPAW",
    "slug": "kinnipaw",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#245B45"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kinnipaw.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#245B45"
      },
      "package": "com.kinnipaw.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "kinnipaw"
  }
}
